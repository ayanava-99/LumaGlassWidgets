<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required solely by AdMob SDK & Google Play Billing -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Used locally for Quick-Glance Wi-Fi status card -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LumaGlassApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumaGlassWidgets"
        tools:targetApi="36">

        <!-- Configured via ADMOB_APP_ID in gradle.properties (defaults to Google Test App ID) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LumaGlassWidgets"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Supports launching/reconfiguring directly from launcher widgets -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Category 1: Clocks & Date Widgets -->
        <receiver
            android:name=".glance.ClockWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_clock" />
        </receiver>

        <!-- Category 2: Battery & Device Widgets -->
        <receiver
            android:name=".glance.BatteryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_battery" />
        </receiver>

        <!-- Category 3: Productivity & India-Focused Widgets -->
        <receiver
            android:name=".glance.ProductivityWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_productivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_productivity" />
        </receiver>

        <!-- Category 4: Aesthetic & Photo Widgets -->
        <receiver
            android:name=".glance.PhotoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_photo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_photo" />
        </receiver>

        <!-- Category 5: Minimal Widgets -->
        <receiver
            android:name=".glance.MinimalWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_minimal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_minimal" />
        </receiver>

        <!-- Category 6: Abstract Widgets -->
        <receiver
            android:name=".glance.AbstractWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_abstract">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_abstract" />
        </receiver>

        <!-- Keeps widgets synced on time/timezone changes and app updates without polling -->
        <receiver
            android:name=".glance.SystemEventWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for viral widget showcase card sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
