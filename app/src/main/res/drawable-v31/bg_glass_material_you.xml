<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_accent1_100" />
            <stroke
                android:width="1dp"
                android:color="@android:color/system_accent1_200" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Frosted translucent glass sheen overlay -->
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#33FFFFFF"
                android:startColor="#80FFFFFF"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
