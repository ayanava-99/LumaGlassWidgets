<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#B8111827"
                android:endColor="#990B0F1A"
                android:startColor="#CC1E293B"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
