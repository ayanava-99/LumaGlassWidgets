<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F1E1B4B" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#B3EDE9FE"
                android:endColor="#99DDD6FE"
                android:startColor="#CCF5F3FF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80C4B5FD" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
