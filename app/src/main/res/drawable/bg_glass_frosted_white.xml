<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer shadow halo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <!-- Frosted translucent glass body with specular gradient -->
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#A6FFFFFF"
                android:endColor="#8CF1F5F9"
                android:startColor="#CCFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
